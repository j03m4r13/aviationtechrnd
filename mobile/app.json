{
  "expo": {
    "name": "Aviation Voice MVP",
    "slug": "aviation-voice-mvp",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.example.aviationvoicemvp",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false,
          "microphonePermission": "Allow Aviation Voice to record speech."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Aviation Voice to photograph trip documents.",
          "photosPermission": "Allow Aviation Voice to select trip-document images.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "com.example.aviationvoicemvp"
    }
  }
}
