OPENAI_API_KEY=replace-me
PORT=3000
HOST=0.0.0.0

# Standard transcription mode keeps the cheaper/default single-speaker transcript path.
# Set OPENAI_TRANSCRIPTION_MODE=speaker_diarization to use gpt-4o-transcribe-diarize
# with response_format=diarized_json and chunking_strategy=auto.
OPENAI_TRANSCRIPTION_MODE=standard
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_DIARIZATION_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_TRANSLATION_MODEL=gpt-5.4-mini

# Improves diarized cockpit/radio pickup by filtering and normalizing each chunk before upload.
# Set AUDIO_TRANSCRIPTION_ENHANCEMENT=false to disable this fallback-safe preprocessing.
AUDIO_TRANSCRIPTION_ENHANCEMENT=true
AUDIO_TRANSCRIPTION_ENHANCEMENT_FILTER=highpass=f=120,lowpass=f=4200,dynaudnorm=f=150:g=15:p=0.95
AUDIO_TRANSCRIPTION_ENHANCEMENT_REQUIRED=false

# Supabase Dashboard -> Project Settings / API Keys
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Used only for internal cost estimates in usage_events. Update when pricing changes.
TRANSCRIPTION_COST_PER_MINUTE_USD=0.003
TRANSLATION_INPUT_COST_PER_MILLION_USD=0.75
TRANSLATION_OUTPUT_COST_PER_MILLION_USD=4.50
